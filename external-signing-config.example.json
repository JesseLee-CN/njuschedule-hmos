{
  "signingConfigs": [
    {
      "name": "localDebug",
      "type": "HarmonyOS",
      "material": {
        "certpath": "C:/path/to/local-signing-certificate.cer",
        "keyAlias": "LOCAL_KEY_ALIAS",
        "keyPassword": "LOCAL_ENCRYPTED_KEY_PASSWORD",
        "profile": "C:/path/to/local-debug-profile.p7b",
        "signAlg": "SHA256withECDSA",
        "storeFile": "C:/path/to/local-keystore.p12",
        "storePassword": "LOCAL_ENCRYPTED_STORE_PASSWORD"
      }
    }
  ],
  "productSigningConfigs": {
    "default": "localDebug"
  }
}
