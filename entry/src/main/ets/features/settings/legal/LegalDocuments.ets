  title: string;
  version: string;
  effectiveDate: string;
  intro: string[];
  sections: LegalSection[];

  constructor(title: string, version: string, effectiveDate: string, intro: string[],
    sections: LegalSection[]) {
    this.title = title;
    this.version = version;
    this.effectiveDate = effectiveDate;
    this.intro = intro;
    this.sections = sections;
  }
}

