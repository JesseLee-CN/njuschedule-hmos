/** 按组件名查找（许可证详情页用）。 */
export function findThirdPartyLicense(name: string): ThirdPartyLicense | undefined {
  for (let i = 0; i < THIRD_PARTY_LICENSES.length; i++) {
    if (THIRD_PARTY_LICENSES[i].name === name) {
      return THIRD_PARTY_LICENSES[i];
    }
  }
  return undefined;
}